CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_16MB.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_TONEX_CONTROLLER_HARDWARE_PLATFORM_WAVESHARE_7B=y
CONFIG_TONEX_CONTROLLER_HAS_DISPLAY=y
CONFIG_TONEX_CONTROLLER_DISPLAY_SMALL=n
CONFIG_TONEX_CONTROLLER_GPIO_FOOTSWITCHES=y
CONFIG_TONEX_CONTROLLER_HAS_TOUCH=y
CONFIG_TONEX_CONTROLLER_DISPLAY_FULL_UI=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_TONEX_CONTROLLER_SHOW_BPM_INDICATOR=y
# RS485 port is half-duplex, so received Midi can't be echoed back out
CONFIG_TONEX_CONTROLLER_ENABLE_MIDI_THRU=n
# More PSRAM read bandwidth for the RGB panel bounce buffer copies
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
